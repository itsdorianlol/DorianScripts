local SAVE_FILE = "UniversalScript_Teleports.json"
local function saveTeleports(data)
    local ok, enc = pcall(HttpService.JSONEncode, HttpService, data)
    if ok then pcall(writefile, SAVE_FILE, enc) end
end
local function loadTeleports()
    local ok, raw = pcall(readfile, SAVE_FILE)
    if ok and raw and raw ~= "" then
        local ok2, dec = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok2 and type(dec) == "table" then return dec end
    end
    return {}
end
