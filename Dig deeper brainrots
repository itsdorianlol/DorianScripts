local function makeDraggable(frame, handle)
    handle = handle or frame
    local drag, ds, sp
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; ds = i.Position; sp = frame.Position
        end
    end)
    handle.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local d = i.Position - ds
            frame.Position = UDim2.new(sp.X.Scale, sp.X.Offset+d.X,
                                       sp.Y.Scale, sp.Y.Offset+d.Y)
        end
    end)
    handle.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
end

-- sub-GUI frame factory
local function makePanel(root, w, h, x, y)
    local f = Instance.new("Frame", root)
    f.Size             = UDim2.new(0,w,0,h)
    f.Position         = UDim2.new(0,x,0,y)
    f.BackgroundColor3 = BG_DARK
    f.BorderSizePixel  = 0
    f.Visible          = false
    corner(f, 14)
    stroke(f)
    return f
end

-- ============================================================
--  FLY LOGIC
-- ============================================================
local function startFly()
    local c = getChar(); if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    hum.PlatformStand = true

    bodyVel           = Instance.new("BodyVelocity", hrp)
    bodyVel.MaxForce  = Vector3.new(1e9,1e9,1e9)
    bodyVel.Velocity  = Vector3.zero
    bodyVel.P         = 1e5

    bodyGyro           = Instance.new("BodyGyro", hrp)
    bodyGyro.MaxTorque = Vector3.new(1e9,1e9,1e9)
    bodyGyro.P         = 1e4
    bodyGyro.D         = 100

    flyConn = RunService.Heartbeat:Connect(function()
        local c2   = getChar(); if not c2 then return end
        local h2   = c2:FindFirstChild("HumanoidRootPart")
        local hum2 = c2:FindFirstChildOfClass("Humanoid")
        if not h2 or not hum2 then return end

        local camCF = Camera.CFrame
        local move  = hum2.MoveDirection

        local vel = Vector3.zero
        if move.Magnitude > 0.05 then
            local flatFwd   = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            local flatRight = Vector3.new(camCF.RightVector.X,0, camCF.RightVector.Z)
            if flatFwd.Magnitude   > 0 then flatFwd   = flatFwd.Unit   end
            if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end
            local fwdAmt    = move:Dot(flatFwd)
            local strafeAmt = move:Dot(flatRight)
            -- full camera LookVector → looking up pitches you upward
            vel = camCF.LookVector * fwdAmt * flySpeed
                + flatRight        * strafeAmt * flySpeed
        end
        if bodyVel  and bodyVel.Parent  then bodyVel.Velocity = vel   end
        if bodyGyro and bodyGyro.Parent then bodyGyro.CFrame  = camCF end
    end)
end

local function stopFly()
    if flyConn  then flyConn:Disconnect();  flyConn  = nil end
    if bodyVel  then bodyVel:Destroy();     bodyVel  = nil end
    if bodyGyro then bodyGyro:Destroy();    bodyGyro = nil end
    local c = getChar()
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end
end

