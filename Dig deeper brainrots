-- --- BUTTON CREATOR ---
local function createBtn(text, pos, parent)
	local b = Instance.new("TextButton", parent)
	b.Size = UDim2.new(0.9, 0, 0, 35)
	b.Position = pos
	b.Text = text
	b.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.Gotham
	style(b, 6)
	return b
end

