local function updateCanvas()
    local n = 0; for _ in pairs(teleportData) do n += 1 end
    tpScroll.CanvasSize = UDim2.new(0,0,0, n*46)
end

local function buildEntry(name, pos)
    local key = "e_"..name
    if tpScroll:FindFirstChild(key) then tpScroll:FindFirstChild(key):Destroy() end

    local row = Instance.new("Frame", tpScroll)
    row.Name             = key
    row.Size             = UDim2.new(1,0,0,40)
    row.BackgroundColor3 = Color3.fromRGB(20,20,20)
    row.BorderSizePixel  = 0
    corner(row, 8)

    lbl(row, "📌 "..name, UDim2.new(1,-104,1,0), UDim2.new(0,8,0,0),
        Color3.fromRGB(210,210,210), 12)

    local goB = btn(row, "Go", UDim2.new(0,46,0,26),
        UDim2.new(1,-90,0.5,-13), Color3.fromRGB(20,60,20))
    goB.TextColor3 = Color3.fromRGB(160,255,160)
    goB.TextSize   = 12
    goB.MouseButton1Click:Connect(function()
        local c = getChar(); if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = CFrame.new(pos[1], pos[2], pos[3]) end
    end)

    local del = Instance.new("TextButton", row)
    del.Size             = UDim2.new(0,26,0,26)
    del.Position         = UDim2.new(1,-34,0.5,-13)
    del.BackgroundColor3 = Color3.fromRGB(160,20,20)
    del.TextColor3       = Color3.fromRGB(255,255,255)
    del.Text             = "X"; del.Font = Enum.Font.GothamBold
    del.TextSize = 12; del.BorderSizePixel = 0
    corner(del, 6)
    del.MouseButton1Click:Connect(function()
        teleportData[name] = nil
        saveTeleports(teleportData)
        row:Destroy(); updateCanvas()
    end)
end

for n, p in pairs(teleportData) do buildEntry(n, p) end
updateCanvas()

createBtn.MouseButton1Click:Connect(function()
    npBox.Text = ""; NP.Visible = true
end)

npConfirm.MouseButton1Click:Connect(function()
    local name = npBox.Text:match("^%s*(.-)%s*$")
    if name == "" then return end
    local c = getChar(); if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local p = {hrp.Position.X, hrp.Position.Y, hrp.Position.Z}
    teleportData[name] = p
    saveTeleports(teleportData)
    buildEntry(name, p)
    updateCanvas()
    NP.Visible = false
end)

