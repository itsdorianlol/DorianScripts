LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if flyEnabled    then stopFly();    startFly()    end
    if noclipEnabled then stopNoclip(); startNoclip() end
    if godEnabled    then stopGod();    startGod()    end
    if wsEnabled     then applyWalkSpeed()            end
    if jpEnabled     then applyJumpPower()            end
    -- freeze stops on death naturally, turn it off
    if freezeEnabled then
        freezeEnabled = false
        freezeBtn.Text             = "🧊  Freeze: OFF"
        freezeBtn.BackgroundColor3 = BTN_OFF
        freezeBtn.TextColor3       = BTN_TXT
    end
end)

