-- --- SCRIPT LOGIC ---

local flying = false
local noclip = false
local flySpeed = 50
local bv, bg
local savedLocations = {}

-- Toggle GUI
toggleBtn.MouseButton1Click:Connect(function()
	main.Visible = not main.Visible
	if not main.Visible then tpFrame.Visible = false end
end)

