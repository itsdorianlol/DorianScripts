-- ============================================================
--  FREEZE  —  locks character at current position mid-air
--             thumbstick still works for camera but body is anchored
-- ============================================================
local function startFreeze()
    local c = getChar(); if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local hum = c:FindFirstChildOfClass("Humanoid"); if not hum then return end

    hum.PlatformStand = true

    -- BodyPosition holds current XYZ
    freezeBP           = Instance.new("BodyPosition", hrp)
    freezeBP.Position  = hrp.Position
    freezeBP.MaxForce  = Vector3.new(1e9,1e9,1e9)
    freezeBP.P         = 1e5
    freezeBP.D         = 1e3

    -- BodyGyro holds current orientation
    freezeBG           = Instance.new("BodyGyro", hrp)
    freezeBG.CFrame    = hrp.CFrame
    freezeBG.MaxTorque = Vector3.new(1e9,1e9,1e9)
    freezeBG.P         = 1e4
    freezeBG.D         = 100

    -- Re-lock every frame in case physics nudges it
    freezeConn = RunService.Heartbeat:Connect(function()
        if freezeBP and freezeBP.Parent then
            -- intentionally do NOT update position → stays locked
        end
    end)
end

local function stopFreeze()
    if freezeConn then freezeConn:Disconnect(); freezeConn = nil end
    if freezeBP   then freezeBP:Destroy();      freezeBP   = nil end
    if freezeBG   then freezeBG:Destroy();      freezeBG   = nil end
    local c = getChar()
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end
end

-- ============================================================
--  NOCLIP
-- ============================================================
local function startNoclip()
    noclipConn = RunService.Stepped:Connect(function()
        local c = getChar(); if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end
local function stopNoclip()
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    local c = getChar(); if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = true end
    end
end

-- ============================================================
--  GOD MODE
-- ============================================================
local function startGod()
    local c = getChar(); if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
    h.MaxHealth = math.huge
    h.Health    = math.huge
    godConn = RunService.Heartbeat:Connect(function()
        local c2 = getChar(); if not c2 then return end
        local h2 = c2:FindFirstChildOfClass("Humanoid"); if not h2 then return end
        if h2.Health < h2.MaxHealth then h2.Health = h2.MaxHealth end
    end)
    pcall(function() LocalPlayer.SimulationRadius = 0 end)
end
local function stopGod()
    if godConn then godConn:Disconnect(); godConn = nil end
    local c = getChar(); if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
    h.MaxHealth = 100; h.Health = 100
    pcall(function() LocalPlayer.SimulationRadius = 1000 end)
end

