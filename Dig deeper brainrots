-- --- LOGIC ---
local flying, noclip = false, false
local flySpeed = 50
local bv, bg
local savedLocations = {}

local function saveToDelta()
	local data = {}
	for i, cf in pairs(savedLocations) do data[i] = {cf.X, cf.Y, cf.Z} end
	writefile(FILE_NAME, HttpService:JSONEncode(data))
end

local function addTpBtn(name, cframe)
	local b = createBtn(name, UDim2.new(0,0,0,0), tpList)
	b.Size = UDim2.new(1, 0, 0, 35)
	b.MouseButton1Click:Connect(function()
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			player.Character.HumanoidRootPart.CFrame = cframe
		end
	end)
end

if isfile(FILE_NAME) then
	local decoded = HttpService:JSONDecode(readfile(FILE_NAME))
	for i, p in pairs(decoded) do
		local cf = CFrame.new(p[1], p[2], p[3])
		table.insert(savedLocations, cf)
		addTpBtn("Saved Spot " .. i, cf)
	end
end

toggleBtn.MouseButton1Click:Connect(function() main.Visible = not main.Visible end)
tpMenuBtn.MouseButton1Click:Connect(function() tpFrame.Visible = not tpFrame.Visible end)

savePosBtn.MouseButton1Click:Connect(function()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		table.insert(savedLocations, root.CFrame)
		addTpBtn("Spot " .. #savedLocations, root.CFrame)
		saveToDelta()
	end
end)

-- --- CLASSIC BODYVELOCITY FLY ---
local function startFly()
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	char.Humanoid.PlatformStand = true
	
	bg = Instance.new("BodyGyro", char.HumanoidRootPart)
	bg.P = 9e4
	bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bg.CFrame = char.HumanoidRootPart.CFrame
	
	bv = Instance.new("BodyVelocity", char.HumanoidRootPart)
	bv.Velocity = Vector3.new(0, 0.1, 0)
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
end

local function stopFly()
	if bv then bv:Destroy() end
	if bg then bg:Destroy() end
	if player.Character and player.Character:FindFirstChild("Humanoid") then
		player.Character.Humanoid.PlatformStand = false
	end
end

flyBtn.MouseButton1Click:Connect(function()
	flying = not flying
	flyBtn.Text = flying and "Fly: ON" or "Fly: OFF"
	flyBtn.BackgroundColor3 = flying and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(25, 25, 25)
	if flying then startFly() else stopFly() end
end)

noclipBtn.MouseButton1Click:Connect(function()
	noclip = not noclip
	noclipBtn.Text = noclip and "Noclip: ON" or "Noclip: OFF"
	noclipBtn.BackgroundColor3 = noclip and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(25, 25, 25)
end)

speedInput:GetPropertyChangedSignal("Text"):Connect(function()
	flySpeed = tonumber(speedInput.Text) or 50
end)

RunService.RenderStepped:Connect(function()
	if noclip and player.Character then
		for _, v in pairs(player.Character:GetDescendants()) do
			if v:IsA("BasePart") then v.CanCollide = false end
		end
	end
	
	if flying and bv and bg and player.Character then
		local cam = workspace.CurrentCamera
		local hum = player.Character.Humanoid
		
		-- Use Joystick MoveDirection
		bv.Velocity = hum.MoveDirection * flySpeed
		bg.CFrame = cam.CFrame
		
		-- Keep you from falling if you aren't moving the joystick
		if hum.MoveDirection.Magnitude == 0 then
			bv.Velocity = Vector3.new(0, 0.1, 0)
		end
	end
end)
